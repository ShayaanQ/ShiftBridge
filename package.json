{
  "name": "shiftbridge",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p backend/tsconfig.json",
    "start:dev": "ts-node backend/src/main.ts",
    "test": "jest --runInBand",
    "test:integration": "DATABASE_URL_TEST=${DATABASE_URL_TEST:-postgresql://shiftbridge:shiftbridge@localhost:5433/shiftbridge_test?schema=public} jest --runInBand backend/test/concurrency.int.spec.ts",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "prisma:migrate:test": "DATABASE_URL=postgresql://shiftbridge:shiftbridge@localhost:5433/shiftbridge_test?schema=public prisma migrate deploy --schema backend/prisma/schema.prisma",
    "prisma:seed": "ts-node backend/prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node backend/prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "csv-parse": "^5.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
